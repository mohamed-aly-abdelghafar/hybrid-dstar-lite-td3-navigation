<?xml version="1.0"?>
<!--
  Dynamic Complex test environment: a 10 m x 10 m arena with 8 internal walls and 8 obstacles
  that patrol back and forth along straight lines (libpatrol_obstacle.so). Each obstacle's
  <offset> and <period> are relative to its spawn pose.
-->
<sdf version="1.6">
  <world name="dynamic_complex">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Outer walls (x, y = +-5) and internal walls -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.2 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.2 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.2 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.2 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="internal_wall_1">
      <static>true</static>
      <pose>-2.5 3.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.2 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="internal_wall_2">
      <static>true</static>
      <pose>3.0 2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 2.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 2.0 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="internal_wall_3">
      <static>true</static>
      <pose>0.0 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.2 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="internal_wall_4">
      <static>true</static>
      <pose>-3.0 -2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 2.0 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 2.0 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="internal_wall_5">
      <static>true</static>
      <pose>2.5 -3.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.2 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="internal_wall_6">
      <static>true</static>
      <pose>-1.0 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.5 0.2 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="internal_wall_7">
      <static>true</static>
      <pose>2.0 0.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 1.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 1.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="internal_wall_8">
      <static>true</static>
      <pose>-2.0 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 1.5 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 1.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.4 0.1 1</ambient><diffuse>0.8 0.4 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Patrolling obstacles (spawn poses are inside the arena) -->

    <!-- Obstacle 1: starts at (-4, 4), patrols to (2, 4) and back every 24 s -->
    <model name="dynamic_obstacle_1">
      <pose>-4.0 4.0 0.15 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="patrol" filename="libpatrol_obstacle.so">
        <offset>6.0 0.0 0</offset>
        <period>24.0</period>
      </plugin>
    </model>

    <!-- Obstacle 2: starts at (4, 3), patrols to (4, -3) and back every 28 s -->
    <model name="dynamic_obstacle_2">
      <pose>4.0 3.0 0.15 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="patrol" filename="libpatrol_obstacle.so">
        <offset>0.0 -6.0 0</offset>
        <period>28.0</period>
      </plugin>
    </model>

    <!-- Obstacle 3: starts at (-4, -4), patrols to (0, -4) and back every 20 s -->
    <model name="dynamic_obstacle_3">
      <pose>-4.0 -4.0 0.15 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="patrol" filename="libpatrol_obstacle.so">
        <offset>4.0 0.0 0</offset>
        <period>20.0</period>
      </plugin>
    </model>

    <!-- Obstacle 4: starts at (-4, -3), patrols to (-4, 3) and back every 26 s -->
    <model name="dynamic_obstacle_4">
      <pose>-4.0 -3.0 0.15 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="patrol" filename="libpatrol_obstacle.so">
        <offset>0.0 6.0 0</offset>
        <period>26.0</period>
      </plugin>
    </model>

    <!-- Obstacle 5: starts at (4, -4), patrols to (1, -4) and back every 22 s -->
    <model name="dynamic_obstacle_5">
      <pose>4.0 -4.0 0.15 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="patrol" filename="libpatrol_obstacle.so">
        <offset>-3.0 0.0 0</offset>
        <period>22.0</period>
      </plugin>
    </model>

    <!-- Obstacle 6: starts at (-1, 2), patrols to (2, 2) and back every 18 s -->
    <model name="dynamic_obstacle_6">
      <pose>-1.0 2.0 0.15 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="patrol" filename="libpatrol_obstacle.so">
        <offset>3.0 0.0 0</offset>
        <period>18.0</period>
      </plugin>
    </model>

    <!-- Obstacle 7: starts at (0, -3), patrols to (2, -1.5) and back every 16 s -->
    <model name="dynamic_obstacle_7">
      <pose>0.0 -3.0 0.15 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="patrol" filename="libpatrol_obstacle.so">
        <offset>2.0 1.5 0</offset>
        <period>16.0</period>
      </plugin>
    </model>

    <!-- Obstacle 8: starts at (3, 4.2), patrols to (0, 2.5) and back every 20 s -->
    <model name="dynamic_obstacle_8">
      <pose>3.0 4.2 0.15 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>1.0 1.0 1.0 1</ambient><diffuse>1.0 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
      <plugin name="patrol" filename="libpatrol_obstacle.so">
        <offset>-3.0 -1.7 0</offset>
        <period>20.0</period>
      </plugin>
    </model>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 15 0 1.57 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
